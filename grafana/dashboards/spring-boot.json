    {
      "id": 8,
      "title": "Items Processed",
      "description": "Custom counter tracking items processed by operation type",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
