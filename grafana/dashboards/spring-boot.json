      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "jvm_threads_current{job=\"spring-boot-app\"}",
          "legendFormat": "threads"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
