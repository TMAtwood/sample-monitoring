    {
      "id": 11,
      "title": "Database Size",
      "description": "Size of each database on disk over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "pg_database_size_bytes{datname!~\"template.*\"}",
