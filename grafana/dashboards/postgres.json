        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "rate(pg_stat_database_tup_updated_total{datname=\"orders_db\"}[5m])",
          "legendFormat": "updated"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "rate(pg_stat_database_tup_deleted_total{datname=\"orders_db\"}[5m])",
          "legendFormat": "deleted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 400,
