{
  "id": null,
  "uid": "tracing",
  "title": "Distributed Tracing",
  "tags": [
    "tracing",
    "tempo"
  ],
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "spring-boot-app,dotnet-app,fastapi-app,azure-func",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "label": "Service",
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "Service Overview",
      "type": "link",
      "url": "/d/overview",
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/infrastructure",
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service Map",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "nodeGraph",
      "title": "Service Dependency Graph",
      "description": "Auto-generated from Tempo span metrics. Shows request flow between services.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "serviceMap",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Trace Search",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent Traces",
      "description": "Search traces by service. Click a Trace ID to view the full trace waterfall.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "refId": "A",
          "filters": [
            {
              "id": "service-name",
              "tag": "service.name",
              "operator": "=",
              "value": [
                "$service"
              ],
              "scope": "resource"
            }
          ],
          "limit": 20
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Trace Metrics (from Tempo Metrics Generator)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Span Rate by Service",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Span Duration P95 by Service",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error Spans by Service",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Traces per Service (last 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "targets": [
        {
          "expr": "sum by (service) (increase(traces_spanmetrics_calls_total[1h]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      }
    }
  ]
}
